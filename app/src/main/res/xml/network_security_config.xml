<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      WebView は内蔵サーバー(127.0.0.1:8080)を平文 HTTP で読む必要があるため、
      loopback に限って cleartext を許可する。
      usesCleartextTraffic="true" のような全体許可はしない（Open-Meteo は HTTPS のまま）。
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!--
      強震モニタ（防災科研）は HTTPS を提供しておらず、443 は応答しない。
      公開の地図画像を表示するためだけに、このホストに限って平文を許可する。
      取得するのは誰でも見られる観測画像で、こちらからは何も送らない。
      経路上で差し替えられ得る点は承知のうえで、判断材料ではなく参考表示として扱う。
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">www.kmoni.bosai.go.jp</domain>
    </domain-config>
    <!--
      Android 7.1.1 未満は Let's Encrypt のルート（ISRG Root X1/X2）を持っておらず、
      天気の取得先（Open-Meteo）に TLS で繋がらない。OS の証明書に加えて同梱のルートも信頼する。
      新しい端末では OS がすでに持っているので挙動は変わらない。
      同梱のファイルは macOS 標準のルート証明書から取り出し、crt.sh の SHA-256 と照合したもの。
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
</network-security-config>
